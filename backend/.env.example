# IBM watsonx.ai Studio Credentials
# Copy this file to .env and fill in your credentials

# Your IBM Cloud API Key
# Get it from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_api_key_here

# Your IBM watsonx.ai Project ID
# Get it from: https://dataplatform.cloud.ibm.com/ → Your Project → Manage → General → Project ID
WATSONX_PROJECT_ID=your_project_id_here

# IBM watsonx.ai URL (region-specific)
# US Dallas:  https://us-south.ml.cloud.ibm.com
# EU Frankfurt: https://eu-de.ml.cloud.ibm.com
# UK London:  https://eu-gb.ml.cloud.ibm.com
# JP Tokyo:   https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Foundation Model ID to use
# Recommended: ibm/granite-13b-instruct-v2  or  meta-llama/llama-3-70b-instruct
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct
